{
  "name": "violet-shop-demo",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "embed": "node scripts/embed-html.mjs",
    "dev": "wrangler dev",
    "deploy": "npm test && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "create:store": "node scripts/create-store.mjs",
    "check:encoding": "node scripts/check-utf8.mjs",
    "check:category-assets": "node scripts/check-category-assets.mjs",
    "test": "npm run check:encoding && npm run check:category-assets && npm run check:generated && npm run check:syntax && npm run test:unit",
    "check:generated": "node scripts/embed-html.mjs --check",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "check:build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "audit:data": "node scripts/audit-data.mjs",
    "verify": "npm run embed && npm test && npm run test:migrations && npm run check:build"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

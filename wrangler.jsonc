{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "violet-shop-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "STORE_ID": "violet-shop-staging",
    "STORE_NAME": "VIOLET SHOP",
    "STORE_LOCALE": "ru-BY",
    "STORE_TIMEZONE": "Europe/Minsk",
    "STORE_CURRENCY": "BYN",
    "GOOGLE_SHEET_ID": "1jNoG5NTnJZbNCx7iAq3S1CcuS0J1EDc8BWeW-nzKNtk",
    "GOOGLE_CATALOG_GID": "782461029",
    "GOOGLE_CATEGORIES_GID": "1963280444"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "violet-shop-staging-db",
      "database_id": "25266668-1919-4683-ba5f-ff3109945c2a",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./assets"
  }
}

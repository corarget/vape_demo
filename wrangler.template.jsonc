{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replace-with-client-slug",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "STORE_NAME": "New Store",
    "GOOGLE_SHEET_ID": "",
    "GOOGLE_CATALOG_GID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-client-db",
      "database_id": "REPLACE_WITH_NEW_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}

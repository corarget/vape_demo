{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replace-with-client-slug",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "STORE_ID": "replace-with-client-slug",
    "STORE_NAME": "Магазин",
    "STORE_LOCALE": "ru-BY",
    "STORE_TIMEZONE": "Europe/Minsk",
    "STORE_CURRENCY": "BYN",
    "GOOGLE_SHEET_ID": "",
    "GOOGLE_CATALOG_GID": "",
    "GOOGLE_CATEGORIES_GID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-client-db",
      "database_id": "REPLACE_WITH_NEW_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./assets"
  }
}
